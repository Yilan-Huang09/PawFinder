# Flask
FLASK_ENV=development
FLASK_DEBUG=1
JWT_SECRET_KEY=replace-with-a-long-random-value

# MySQL
DATABASE_URL=mysql+pymysql://pawfinder:change_me@127.0.0.1:3306/pawfinder?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://pawfinder:change_me@127.0.0.1:3306/pawfinder_test?charset=utf8mb4

# Docker Compose (optional; defaults match docker-compose.yml)
MYSQL_ROOT_PASSWORD=pawfinder_root
MYSQL_PASSWORD=change_me
MYSQL_PORT=3307
WEB_PORT=8080

# Uploads
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=10485760

# Frontend integrations
VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1
VITE_AMAP_JS_KEY=

# Optional OpenAI-compatible model service
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=8
